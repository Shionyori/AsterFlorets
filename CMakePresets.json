{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-msvc",
            "displayName": "Windows MSVC",
            "description": "Build using Visual Studio 17 2022 generator",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ASTERUI_BUILD_EXAMPLES": "ON",
                "ASTERUI_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "linux-mingw",
            "displayName": "Linux MinGW",
            "description": "Build using Ninja generator and MinGW",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-mingw",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ASTERUI_BUILD_EXAMPLES": "ON",
                "ASTERUI_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc",
            "configurePreset": "windows-msvc"
        },
        {
            "name": "linux-mingw",
            "configurePreset": "linux-mingw"
        }
    ]
}
