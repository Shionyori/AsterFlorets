{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-msvc",
            "displayName": "Windows MSVC",
            "description": "Build using Visual Studio 17 2022 generator",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-msvc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ASTER_BUILD_EXAMPLES": "ON",
                "ASTER_BUILD_TESTS": "ON"
            }
        },
        {
            "name":"windows-msvc-release",
            "displayName": "Windows MSVC Release",
            "description": "Build using Visual Studio 17 2022 generator in Release mode",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-msvc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ASTER_BUILD_EXAMPLES": "ON",
                "ASTER_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc",
            "configurePreset": "windows-msvc"
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc-release"
        }
    ]
}
